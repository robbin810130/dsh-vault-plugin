{
  "name": "dsh-vault-plugin",
  "version": "0.2.9",
  "description": "DSH \u4fdd\u9669\u7bb1\u63d2\u4ef6\uff1a\u9879\u76ee\u4e0e\u5bf9\u8bdd\u7684\u524d\u53f0\u9690\u79c1\u9501",
  "type": "module",
  "bin": {
    "dsh-vault": "./plugin/lib/cli.js"
  },
  "main": "./plugin/lib/index.js",
  "types": "./plugin/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./plugin/lib/index.d.ts",
      "default": "./plugin/lib/index.js"
    },
    "./client": {
      "types": "./plugin/lib/client.d.ts",
      "default": "./plugin/lib/client.js"
    },
    "./shared": {
      "types": "./plugin/lib/index.d.ts",
      "default": "./plugin/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/lib",
    "plugin/cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-primitives",
        "react",
        "react/jsx-runtime",
        "react-dom"
      ],
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbin810130/dsh-vault-plugin.git"
  },
  "homepage": "https://github.com/robbin810130/dsh-vault-plugin",
  "bugs": {
    "url": "https://github.com/robbin810130/dsh-vault-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "vault",
    "privacy",
    "plugin"
  ]
}
