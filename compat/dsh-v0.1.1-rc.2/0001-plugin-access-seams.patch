diff --git a/packages/client/runtime/tests/navigation-access.client.spec.ts b/packages/client/runtime/tests/navigation-access.client.spec.ts
new file mode 100644
index 0000000000..97cb975ca6
--- /dev/null
+++ b/packages/client/runtime/tests/navigation-access.client.spec.ts
@@ -0,0 +1,187 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { SessionId, WorkspaceId } from '@deepseek-ai/dsh-api-remotes/client'
+import {
+  NavigationAccessRegistry,
+  type NavigationAccessProvider,
+  type NavigationAccessState,
+} from '../src/client/navigation/access.ts'
+
+const sid = (id: string): SessionId => id as SessionId
+const wid = (id: string): WorkspaceId => id as WorkspaceId
+const allowState: NavigationAccessState = { kind: 'allow' }
+const failedState: NavigationAccessState = { kind: 'blocked', reason: 'navigation access provider failed' }
+
+interface FakeProviderOptions {
+  readonly matchesSession?: boolean | ((id: SessionId) => boolean)
+  readonly matchesWorkspace?: boolean | ((id: WorkspaceId) => boolean)
+  readonly requestAllow?: boolean
+  readonly requestError?: Error
+  readonly stateError?: Error
+  readonly state?: NavigationAccessState
+}
+
+type FakeNavigationAccessProvider = NavigationAccessProvider & {
+  emit(): void
+  listenerCount(): number
+  requestSessionCallCount(): number
+  requestWorkspaceCallCount(): number
+}
+
+function fakeProvider(options: FakeProviderOptions = {}): FakeNavigationAccessProvider {
+  const listeners = new Set<() => void>()
+  const matchesSession = options.matchesSession ?? true
+  const matchesWorkspace = options.matchesWorkspace ?? true
+  const state = options.state ?? allowState
+  const requestWorkspace = vi.fn(async () => {
+    if (options.requestError !== undefined) throw options.requestError
+    return { allow: options.requestAllow ?? true }
+  })
+  const requestSession = vi.fn(async () => {
+    if (options.requestError !== undefined) throw options.requestError
+    return { allow: options.requestAllow ?? true }
+  })
+  const provider = {
+    matchesWorkspace: vi.fn((id: WorkspaceId) => {
+      if (typeof matchesWorkspace === 'function') return matchesWorkspace(id)
+      return matchesWorkspace
+    }),
+    matchesSession: vi.fn((id: SessionId) => {
+      if (typeof matchesSession === 'function') return matchesSession(id)
+      return matchesSession
+    }),
+    workspaceState: vi.fn(() => {
+      if (options.stateError !== undefined) throw options.stateError
+      return state
+    }),
+    sessionState: vi.fn(() => {
+      if (options.stateError !== undefined) throw options.stateError
+      return state
+    }),
+    requestWorkspace,
+    requestSession,
+    subscribe: vi.fn((listener: () => void) => {
+      listeners.add(listener)
+      return () => { listeners.delete(listener) }
+    }),
+    emit: () => {
+      for (const listener of listeners) listener()
+    },
+    listenerCount: () => listeners.size,
+    requestSessionCallCount: () => requestSession.mock.calls.length,
+    requestWorkspaceCallCount: () => requestWorkspace.mock.calls.length,
+  }
+  return provider
+}
+
+describe('NavigationAccessRegistry', () => {
+  it('bypasses providers that do not match the session', async () => {
+    const provider = fakeProvider({ matchesSession: false })
+    const registry = new NavigationAccessRegistry()
+    registry.register(provider)
+    expect(await registry.requestSession(sid('plain'))).toEqual({ allow: true })
+    expect(provider.requestSessionCallCount()).toBe(0)
+  })
+
+  it('denies a matching provider failure', async () => {
+    const provider = fakeProvider({ matchesSession: true, requestError: new Error('offline') })
+    const registry = new NavigationAccessRegistry()
+    registry.register(provider)
+    await expect(registry.requestSession(sid('locked'))).resolves.toEqual({ allow: false })
+  })
+
+  it('blocks target state when a matching provider state read throws', () => {
+    const provider = fakeProvider({ matchesSession: true, matchesWorkspace: true, stateError: new Error('state offline') })
+    const registry = new NavigationAccessRegistry()
+    registry.register(provider)
+
+    expect(registry.workspaceState(wid('locked'))).toEqual(failedState)
+    expect(registry.sessionState(sid('locked'))).toEqual(failedState)
+  })
+
+  it('denies requests when provider matchers throw before a request is made', async () => {
+    const provider = fakeProvider({
+      matchesSession: () => { throw new Error('match offline') },
+      matchesWorkspace: () => { throw new Error('match offline') },
+    })
+    const registry = new NavigationAccessRegistry()
+    registry.register(provider)
+
+    await expect(registry.requestWorkspace(wid('locked'))).resolves.toEqual({ allow: false })
+    await expect(registry.requestSession(sid('locked'))).resolves.toEqual({ allow: false })
+    expect(provider.requestWorkspaceCallCount()).toBe(0)
+    expect(provider.requestSessionCallCount()).toBe(0)
+  })
+
+  it('requires every matching session provider to allow and lets one denial win', async () => {
+    const registry = new NavigationAccessRegistry()
+    const allow = fakeProvider({ matchesSession: true, requestAllow: true })
+    const deny = fakeProvider({ matchesSession: true, requestAllow: false })
+    const later = fakeProvider({ matchesSession: true, requestAllow: true })
+    registry.register(allow)
+    registry.register(deny)
+    registry.register(later)
+
+    await expect(registry.requestSession(sid('locked'))).resolves.toEqual({ allow: false })
+    expect(allow.requestSessionCallCount()).toBe(1)
+    expect(deny.requestSessionCallCount()).toBe(1)
+    expect(later.requestSessionCallCount()).toBe(0)
+  })
+
+  it('keeps registration order stable for workspace state and requests', async () => {
+    const registry = new NavigationAccessRegistry()
+    const firstBlocked: NavigationAccessState = { kind: 'blocked', reason: 'first' }
+    const secondBlocked: NavigationAccessState = { kind: 'blocked', reason: 'second' }
+    const calls: string[] = []
+    const first = fakeProvider({ matchesWorkspace: true, state: firstBlocked, requestAllow: true })
+    const second = fakeProvider({ matchesWorkspace: true, state: secondBlocked, requestAllow: true })
+    first.requestWorkspace = vi.fn(async () => {
+      calls.push('first')
+      return { allow: true }
+    })
+    second.requestWorkspace = vi.fn(async () => {
+      calls.push('second')
+      return { allow: true }
+    })
+    registry.register(first)
+    registry.register(second)
+
+    expect(registry.workspaceState(wid('locked'))).toEqual(firstBlocked)
+    await expect(registry.requestWorkspace(wid('locked'))).resolves.toEqual({ allow: true })
+    expect(calls).toEqual(['first', 'second'])
+  })
+
+  it('returns allow when no matching provider blocks a target state', () => {
+    const registry = new NavigationAccessRegistry()
+    registry.register(fakeProvider({ matchesWorkspace: false }))
+    registry.register(fakeProvider({ matchesWorkspace: true, state: allowState }))
+
+    expect(registry.workspaceState(wid('plain'))).toEqual({ kind: 'allow' })
+  })
+
+  it('relays provider changes to subscribers', () => {
+    const registry = new NavigationAccessRegistry()
+    const provider = fakeProvider()
+    const listener = vi.fn()
+    registry.register(provider)
+    const unsubscribe = registry.subscribe(listener)
+
+    provider.emit()
+
+    expect(listener).toHaveBeenCalledOnce()
+    unsubscribe()
+    provider.emit()
+    expect(listener).toHaveBeenCalledOnce()
+  })
+
+  it('removes the provider and its listener on disposal', async () => {
+    const registry = new NavigationAccessRegistry()
+    const provider = fakeProvider({ matchesSession: true, requestAllow: false })
+    const dispose = registry.register(provider)
+    expect(provider.listenerCount()).toBe(1)
+
+    dispose()
+
+    expect(provider.listenerCount()).toBe(0)
+    await expect(registry.requestSession(sid('plain'))).resolves.toEqual({ allow: true })
+  })
+})
