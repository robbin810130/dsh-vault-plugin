+describe('WorkspaceRowsRegistry', () => {
+  it('removes concealed values from visible, hover, copy and aria surfaces', () => {
+    const service = new WorkspaceRowsRegistry()
+    service.register({
+      workspace: (_id, base) => base,
+      session: (_id, base) => base.label === 'Real title'
+        ? {
+          label: '受保护对话',
+          ariaLabel: '打开受保护对话',
+          concealed: true,
+        }
+        : base,
+    })
+
+    const presentation = service.session(sid('s1'), {
+      label: 'Real title', workspaceLabel: 'Secret project', snippet: 'secret text',
+      ariaLabel: 'Open Real title', concealed: false,
+    })
+
+    expect(presentation).toEqual({
+      label: '受保护对话', workspaceLabel: undefined, snippet: undefined,
+      ariaLabel: '打开受保护对话', concealed: true,
+    })
+  })
+
+  it('composes two decorators in registration order and disposal restores the base', () => {
+    const service = new WorkspaceRowsRegistry()
+    const first: WorkspaceRowDecorator = {
+      workspace: (_id, base) => ({ ...base, label: `${base.label} A` }),
+      session: (_id, base) => ({ ...base, label: `${base.label} A`, snippet: `${base.snippet ?? ''} A`.trim() }),
+    }
+    const second: WorkspaceRowDecorator = {
+      workspace: (_id, base) => ({ ...base, label: `${base.label} B` }),
+      session: (_id, base) => ({ ...base, label: `${base.label} B`, snippet: `${base.snippet ?? ''} B`.trim() }),
+    }
+
+    const disposeFirst = service.register(first)
+    service.register(second)
+
+    expect(service.workspace(wid('w1'), baseWorkspace('Workspace'))).toMatchObject({ label: 'Workspace A B' })
+    expect(service.session(sid('s1'), {
+      label: 'Session', ariaLabel: 'Open Session', snippet: 'hit', concealed: false,
+    })).toMatchObject({ label: 'Session A B', snippet: 'hit A B' })
+
+    disposeFirst()
+
+    expect(service.workspace(wid('w1'), baseWorkspace('Workspace'))).toMatchObject({ label: 'Workspace B' })
+  })
+
+  it('notifies subscribers when decorators register and dispose', () => {
+    const service = new WorkspaceRowsRegistry()
+    const listener = vi.fn()
+    const unsubscribe = service.subscribe(listener)
+    const dispose = service.register(identityDecorator)
+
+    expect(listener).toHaveBeenCalledTimes(1)
+    dispose()
+    expect(listener).toHaveBeenCalledTimes(2)
+    unsubscribe()
+    service.register(identityDecorator)
+    expect(listener).toHaveBeenCalledTimes(2)
+  })
+
+  it('conceals a matched workspace when its decorator throws', () => {
+    const service = new WorkspaceRowsRegistry()
+    service.register({
+      matchesWorkspace: id => id === wid('locked'),
+      matchesSession: () => false,
+      workspace: () => { throw new Error('decorator offline') },
+      session: (_id, base) => base,
+    })
+
+    expect(service.workspace(wid('locked'), baseWorkspace('Secret'))).toEqual({
+      label: 'Protected workspace',
+      ariaLabel: 'Open protected workspace',
+      concealed: true,
+    })
+  })
+
+  it('keeps unmatched rows byte-for-byte equivalent when a decorator would otherwise fail', () => {
+    const service = new WorkspaceRowsRegistry()
+    const base = baseSession('Plain')
+    service.register({
+      matchesWorkspace: () => false,
+      matchesSession: () => false,
+      workspace: () => { throw new Error('must not run') },
+      session: () => { throw new Error('must not run') },
+    })
+
+    expect(service.session(sid('plain'), base)).toBe(base)
+  })
+
+  it('uses a matching decorator fallback and conceals if that fallback also fails', () => {
+    const service = new WorkspaceRowsRegistry()
+    service.register({
+      matchesWorkspace: () => false,
+      matchesSession: () => true,
+      workspace: (_id, base) => base,
+      session: () => { throw new Error('decorator offline') },
+      fallbackSession: () => ({
+        label: 'Custom protected',
+        ariaLabel: 'Open custom protected',
+        concealed: true,
+      }),
+    })
+    service.register({
+      matchesWorkspace: () => false,
+      matchesSession: id => id === sid('fallback-crash'),
+      workspace: (_id, base) => base,
+      session: () => { throw new Error('decorator offline') },
+      fallbackSession: () => { throw new Error('fallback offline') },
+    })
+
+    expect(service.session(sid('locked'), baseSession('Secret'))).toEqual({
+      label: 'Custom protected',
+      ariaLabel: 'Open custom protected',
+      concealed: true,
+    })
+    expect(service.session(sid('fallback-crash'), baseSession('Secret'))).toEqual({
+      label: 'Protected session',
+      ariaLabel: 'Open protected session',
+      concealed: true,
+    })
+  })
+})
+
+function baseWorkspace(label: string): WorkspaceRowPresentation {
+  return { label, ariaLabel: `Open ${label}`, concealed: false }
+}
+
+function baseSession(label: string): SessionRowPresentation {
+  return { label, ariaLabel: `Open ${label}`, snippet: 'visible', concealed: false }
+}
+
+const identityDecorator: WorkspaceRowDecorator = {
+  workspace: (_id, base) => base,
+  session: (_id, base) => base,
+}
