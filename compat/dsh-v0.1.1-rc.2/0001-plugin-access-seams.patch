diff --git a/packages/client/runtime/src/client/navigation/access.ts b/packages/client/runtime/src/client/navigation/access.ts
new file mode 100644
index 0000000000..b6af74f44f
--- /dev/null
+++ b/packages/client/runtime/src/client/navigation/access.ts
@@ -0,0 +1,167 @@
+import { Context, Service } from '@deepseek-ai/cordis'
+import type { RpcError, SessionId, WorkspaceId } from '@deepseek-ai/dsh-api-remotes/client'
+
+export type NavigationAccessState =
+  | { readonly kind: 'allow' }
+  | { readonly kind: 'blocked'; readonly reason: string }
+
+export interface NavigationDecision {
+  readonly allow: boolean
+  readonly handled?: boolean
+}
+
+export interface NavigationAccessProvider {
+  matchesWorkspace(id: WorkspaceId): boolean
+  matchesSession(id: SessionId): boolean
+  workspaceState(id: WorkspaceId): NavigationAccessState
+  sessionState(id: SessionId): NavigationAccessState
+  requestWorkspace(id: WorkspaceId): Promise<NavigationDecision>
+  requestSession(id: SessionId): Promise<NavigationDecision>
+  subscribe(listener: () => void): () => void
+}
+
+export interface NavigationAccess {
+  register(provider: NavigationAccessProvider): () => void
+  workspaceState(id: WorkspaceId): NavigationAccessState
+  sessionState(id: SessionId): NavigationAccessState
+  requestWorkspace(id: WorkspaceId): Promise<NavigationDecision>
+  requestSession(id: SessionId): Promise<NavigationDecision>
+  subscribe(listener: () => void): () => void
+}
+
+export type NavigationAccessTarget = 'session' | 'workspace'
+
+export class NavigationAccessDeniedError extends Error {
+  override readonly name = 'NavigationAccessDeniedError'
+
+  constructor(readonly target: NavigationAccessTarget, readonly id: SessionId | WorkspaceId) {
+    super(`navigation access denied for ${target} ${id}`)
+  }
+}
+
+export function navigationAccessDeniedRpcError(
+  target: NavigationAccessTarget,
+  id: SessionId | WorkspaceId,
+): RpcError {
+  return {
+    code: 'internal',
+    message: `navigation access denied for ${target} ${id}`,
+    details: target === 'session' ? { sessionId: id } : { workspaceId: id },
+  }
+}
+
+const ALLOW_STATE: NavigationAccessState = { kind: 'allow' }
+const FAILED_STATE: NavigationAccessState = { kind: 'blocked', reason: 'navigation access provider failed' }
+const ALLOW_DECISION: NavigationDecision = { allow: true }
+const DENY_DECISION: NavigationDecision = { allow: false }
+
+interface ProviderEntry {
+  readonly provider: NavigationAccessProvider
+  readonly unsubscribe: () => void
+}
+
+/**
+ * Ordered, observable access registry for navigation-like host targets.
+ * The optional constructor context keeps standalone registry tests lightweight;
+ * runtime mounting passes the real Cordis context and receives a service face.
+ */
+export class NavigationAccessRegistry extends Service implements NavigationAccess {
+  private readonly providers: ProviderEntry[] = []
+  private readonly listeners = new Set<() => void>()
+
+  constructor(ctx: Context = new Context()) {
+    super(ctx, 'navigationAccess')
+  }
+
+  /**
+   * Register a provider for the caller's Cordis fiber lifetime.
+   * @param provider - access provider contribution.
+   * @returns disposer removing the provider and its change listener.
+   */
+  register(provider: NavigationAccessProvider): () => void {
+    const dispose = this.ctx.effect(() => {
+      const entry: ProviderEntry = {
+        provider,
+        unsubscribe: provider.subscribe(() => { this.notify() }),
+      }
+      this.providers.push(entry)
+      this.notify()
+      return () => {
+        const index = this.providers.indexOf(entry)
+        if (index >= 0) this.providers.splice(index, 1)
+        entry.unsubscribe()
+        this.notify()
+      }
+    }, 'navigationAccess.register()')
+    return () => { void dispose() }
+  }
+
+  workspaceState(id: WorkspaceId): NavigationAccessState {
+    for (const entry of this.providers) {
+      try {
+        if (!entry.provider.matchesWorkspace(id)) continue
+        const state = entry.provider.workspaceState(id)
+        if (state.kind === 'blocked') return state
+      } catch {
+        return FAILED_STATE
+      }
+    }
+    return ALLOW_STATE
+  }
+
+  sessionState(id: SessionId): NavigationAccessState {
+    for (const entry of this.providers) {
+      try {
+        if (!entry.provider.matchesSession(id)) continue
+        const state = entry.provider.sessionState(id)
+        if (state.kind === 'blocked') return state
+      } catch {
+        return FAILED_STATE
+      }
+    }
+    return ALLOW_STATE
+  }
+
+  async requestWorkspace(id: WorkspaceId): Promise<NavigationDecision> {
+    for (const entry of this.providers) {
+      try {
+        if (!entry.provider.matchesWorkspace(id)) continue
+        const decision = await entry.provider.requestWorkspace(id)
+        if (!decision.allow) return decision
+      } catch {
+        return DENY_DECISION
+      }
+    }
+    return ALLOW_DECISION
+  }
+
+  async requestSession(id: SessionId): Promise<NavigationDecision> {
+    for (const entry of this.providers) {
+      try {
+        if (!entry.provider.matchesSession(id)) continue
+        const decision = await entry.provider.requestSession(id)
+        if (!decision.allow) return decision
+      } catch {
+        return DENY_DECISION
+      }
+    }
+    return ALLOW_DECISION
+  }
+
+  /**
+   * Observe provider set/state changes for the caller's Cordis fiber lifetime.
+   * @param listener - synchronous invalidation callback.
+   * @returns disposer removing the listener.
+   */
+  subscribe(listener: () => void): () => void {
+    const dispose = this.ctx.effect(() => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    }, 'navigationAccess.subscribe()')
+    return () => { void dispose() }
+  }
+
+  private notify(): void {
+    for (const listener of this.listeners) listener()
+  }
+}
