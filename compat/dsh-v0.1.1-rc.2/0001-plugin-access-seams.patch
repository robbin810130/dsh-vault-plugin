+
+type AppRootProps = PropsRenderSlots<'conversation' | 'details'>
+function AppRoot({ renderSlot }: AppRootProps) {
+  return <>{renderSlot('conversation', {})}</>
+}
+
+const LAYOUT_CHILDREN = {
+  conversation: { kind: 'single', scope: 'session-maybe' },
+  details: { kind: 'single', scope: 'session' },
+} as const
+
+function NativeViewProbe() {
+  return <div data-testid="native-view" />
+}
+
+function AccessDeniedProbe({ sessionId, reason }: { sessionId: SessionId; reason: string }) {
+  return (
+    <div data-testid="access-denied" data-session-id={sessionId} data-reason={reason}>
+      denied
+    </div>
+  )
+}
+
+function accessHarness(initial: NavigationAccessState = ALLOW) {
+  let state = initial
+  const listeners = new Set<() => void>()
+  const navigationAccess: NavigationAccess = {
+    register: vi.fn(() => () => {}),
+    workspaceState: vi.fn(() => ALLOW),
+    sessionState: vi.fn(() => state),
+    requestWorkspace: vi.fn(async () => ({ allow: true })),
+    requestSession: vi.fn(async () => ({ allow: state.kind === 'allow' })),
+    subscribe: vi.fn((listener: () => void) => {
+      listeners.add(listener)
+      return () => { listeners.delete(listener) }
+    }),
+  }
+  return {
+    navigationAccess,
+    setState(next: NavigationAccessState) {
+      state = next
+      for (const listener of [...listeners]) listener()
+    },
+    disposeProvider() {
+      state = ALLOW
+      for (const listener of [...listeners]) listener()
+    },
+  }
+}
+
+async function bench(opts?: {
+  readonly access?: ReturnType<typeof accessHarness>
+  readonly includeOther?: boolean
+}) {
+  const runtime = await SlotTestRuntime.create()
+  runtime.provide('connection', { api: { settings: {} }, isLoopback: false })
+  runtime.provide('remote', { $on: () => () => {} })
+  runtime.provide('settingsScope', { bind: () => stubSettingsScope().scope } as never)
+  runtime.provide('layout', { openDetails: vi.fn(), closeDetails: vi.fn() })
+  if (opts?.access !== undefined) runtime.provide('navigationAccess', opts.access.navigationAccess)
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.provide('locale', locale)
+  runtime.slots.installLocale(locale)
+  await runtime.sessions.add({
+    id: SID,
+    summary: { title: 'S', displayTitle: 'S', cwd: '/proj' },
+    session: {
+      loadOlder: vi.fn<ISession['loadOlder']>(),
+      prompt: vi.fn<ISession['prompt']>(async () => ({ ok: true, value: { accepted: true } })),
+    },
+  })
+  if (opts?.includeOther === true) {
+    await runtime.sessions.add({
+      id: OTHER,
+      summary: { title: 'T', displayTitle: 'T', cwd: '/other' },
+      session: {
+        loadOlder: vi.fn<ISession['loadOlder']>(),
+        prompt: vi.fn<ISession['prompt']>(async () => ({ ok: true, value: { accepted: true } })),
+      },
+    }, { current: false })
+  }
+  await runtime.root.declare(LAYOUT_CHILDREN, AppRoot)
+  await runtime.mount({ inject: [...inject], apply })
+  runtime.slots.register({ name: 'conversation.view', id: 'chat', priority: -1 } as never, NativeViewProbe)
+  runtime.slots.register({ name: 'conversation.access.denied' } as never, AccessDeniedProbe)
+  const view = runtime.renderRoot()
+  return { runtime, view }
+}
+
+describe('conversation access gate', () => {
+  it('renders only the denied seat for a blocked current session', async () => {
+    const access = accessHarness({ kind: 'blocked', reason: 'locked' })
+    const { runtime, view } = await bench({ access })
+
+    const denied = view.getByTestId('access-denied')
+    expect(denied.getAttribute('data-session-id')).toBe(SID)
+    expect(denied.getAttribute('data-reason')).toBe('locked')
+    expect(view.queryByRole('textbox')).toBeNull()
+    expect(view.queryByRole('navigation', { name: '会话层级' })).toBeNull()
+    expect(view.queryByTestId('native-view')).toBeNull()
+
+    await runtime.dispose()
+  })
+
+  it('remounts the native conversation when the current session is unblocked', async () => {
+    const access = accessHarness({ kind: 'blocked', reason: 'locked' })
+    const { runtime, view } = await bench({ access })
+
+    expect(view.getByTestId('access-denied')).not.toBeNull()
+    access.setState(ALLOW)
+
+    await waitFor(() => {
+      expect(view.queryByTestId('access-denied')).toBeNull()
+      expect(view.queryByRole('textbox')).not.toBeNull()
+      expect(view.queryByTestId('native-view')).not.toBeNull()
+    })
+    await runtime.dispose()
+  })
+
+  it('returns to native rendering when the provider is disposed', async () => {
+    const access = accessHarness({ kind: 'blocked', reason: 'locked' })
+    const { runtime, view } = await bench({ access })
+
+    expect(view.getByTestId('access-denied')).not.toBeNull()
+    access.disposeProvider()
+
+    await waitFor(() => {
+      expect(view.queryByTestId('access-denied')).toBeNull()
+      expect(view.queryByRole('textbox')).not.toBeNull()
+    })
+    await runtime.dispose()
+  })
+
+  it('recomputes access when the current session changes', async () => {
+    const blocked: NavigationAccessState = { kind: 'blocked', reason: 'locked' }
+    const access = accessHarness(blocked)
+    access.navigationAccess.sessionState = vi.fn(id => id === SID ? blocked : ALLOW)
+    const { runtime, view } = await bench({ access, includeOther: true })
+
+    expect(view.getByTestId('access-denied').getAttribute('data-session-id')).toBe(SID)
+    await runtime.sessions.setCurrent(OTHER)
+
+    await waitFor(() => {
+      expect(view.queryByTestId('access-denied')).toBeNull()
+      expect(view.queryByRole('textbox')).not.toBeNull()
+    })
+    await runtime.dispose()
+  })
+
+  it('preserves native behavior when no access service is provided', async () => {
+    const { runtime, view } = await bench()
+
+    expect(view.queryByTestId('access-denied')).toBeNull()
+    expect(view.queryByRole('textbox')).not.toBeNull()
+    expect(view.queryByTestId('native-view')).not.toBeNull()
+
+    await runtime.dispose()
+  })
+})
