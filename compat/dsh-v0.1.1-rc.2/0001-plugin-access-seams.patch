diff --git a/packages/client/ui-workspace/src/client/row-extensions.ts b/packages/client/ui-workspace/src/client/row-extensions.ts
new file mode 100644
index 0000000000..f9a05c4b52
--- /dev/null
+++ b/packages/client/ui-workspace/src/client/row-extensions.ts
@@ -0,0 +1,168 @@
+import { Context, Service } from '@deepseek-ai/cordis'
+import type { SessionId, WorkspaceId } from '@deepseek-ai/dsh-client-runtime/client'
+
+export interface WorkspaceRowPresentation {
+  readonly label: string
+  readonly detail?: string
+  readonly ariaLabel: string
+  readonly concealed: boolean
+}
+
+export interface SessionRowPresentation extends WorkspaceRowPresentation {
+  readonly workspaceLabel?: string
+  readonly snippet?: string
+}
+
+export interface WorkspaceRowDecorator {
+  matchesWorkspace?(id: WorkspaceId, base: WorkspaceRowPresentation): boolean
+  matchesSession?(id: SessionId, base: SessionRowPresentation): boolean
+  workspace?(id: WorkspaceId, base: WorkspaceRowPresentation): WorkspaceRowPresentation
+  session?(id: SessionId, base: SessionRowPresentation): SessionRowPresentation
+  fallbackWorkspace?(id: WorkspaceId, base: WorkspaceRowPresentation, error: unknown): WorkspaceRowPresentation
+  fallbackSession?(id: SessionId, base: SessionRowPresentation, error: unknown): SessionRowPresentation
+}
+
+export interface WorkspaceRows {
+  register(decorator: WorkspaceRowDecorator): () => void
+  workspace(id: WorkspaceId, base: WorkspaceRowPresentation): WorkspaceRowPresentation
+  session(id: SessionId, base: SessionRowPresentation): SessionRowPresentation
+  subscribe(listener: () => void): () => void
+}
+
+export interface WorkspaceRowSlotOwnerProps {
+  readonly workspaceId: WorkspaceId
+  readonly presentation: WorkspaceRowPresentation
+}
+
+export interface SessionRowSlotOwnerProps {
+  readonly sessionId: SessionId
+  readonly workspaceId?: WorkspaceId
+  readonly presentation: SessionRowPresentation
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Composable presentation decorators for workspace and session rows. */
+    workspaceRows: WorkspaceRows
+  }
+}
+
+export class WorkspaceRowsRegistry extends Service implements WorkspaceRows {
+  private readonly decorators: WorkspaceRowDecorator[] = []
+  private readonly listeners = new Set<() => void>()
+  private revisionValue = 0
+
+  constructor(ctx: Context = new Context()) {
+    super(ctx, 'workspaceRows')
+  }
+
+  get revision(): number {
+    return this.revisionValue
+  }
+
+  register(decorator: WorkspaceRowDecorator): () => void {
+    const dispose = this.ctx.effect(() => {
+      this.decorators.push(decorator)
+      this.notify()
+      return () => {
+        const index = this.decorators.indexOf(decorator)
+        if (index >= 0) this.decorators.splice(index, 1)
+        this.notify()
+      }
+    }, 'workspaceRows.register()')
+    return () => { void dispose() }
+  }
+
+  workspace(id: WorkspaceId, base: WorkspaceRowPresentation): WorkspaceRowPresentation {
+    let current = base
+    for (const decorator of this.decorators) current = applyWorkspaceDecorator(decorator, id, current)
+    return current
+  }
+
+  session(id: SessionId, base: SessionRowPresentation): SessionRowPresentation {
+    let current = base
+    for (const decorator of this.decorators) current = applySessionDecorator(decorator, id, current)
+    return current
+  }
+
+  subscribe(listener: () => void): () => void {
+    const dispose = this.ctx.effect(() => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    }, 'workspaceRows.subscribe()')
+    return () => { void dispose() }
+  }
+
+  private notify(): void {
+    this.revisionValue += 1
+    for (const listener of this.listeners) listener()
+  }
+}
+
+function applyWorkspaceDecorator(
+  decorator: WorkspaceRowDecorator,
+  id: WorkspaceId,
+  base: WorkspaceRowPresentation,
+): WorkspaceRowPresentation {
+  try {
+    if (decorator.matchesWorkspace?.(id, base) === false) return base
+    return decorator.workspace?.(id, base) ?? base
+  } catch (error) {
+    return workspaceFallback(decorator, id, base, error)
+  }
+}
+
+function applySessionDecorator(
+  decorator: WorkspaceRowDecorator,
+  id: SessionId,
+  base: SessionRowPresentation,
+): SessionRowPresentation {
+  try {
+    if (decorator.matchesSession?.(id, base) === false) return base
+    return decorator.session?.(id, base) ?? base
+  } catch (error) {
+    return sessionFallback(decorator, id, base, error)
+  }
+}
+
+function workspaceFallback(
+  decorator: WorkspaceRowDecorator,
+  id: WorkspaceId,
+  base: WorkspaceRowPresentation,
+  error: unknown,
+): WorkspaceRowPresentation {
+  try {
+    return decorator.fallbackWorkspace?.(id, base, error) ?? concealedWorkspace()
+  } catch {
+    return concealedWorkspace()
+  }
+}
+
+function sessionFallback(
+  decorator: WorkspaceRowDecorator,
+  id: SessionId,
+  base: SessionRowPresentation,
+  error: unknown,
+): SessionRowPresentation {
+  try {
+    return decorator.fallbackSession?.(id, base, error) ?? concealedSession()
+  } catch {
+    return concealedSession()
+  }
+}
+
+function concealedWorkspace(): WorkspaceRowPresentation {
+  return {
+    label: 'Protected workspace',
+    ariaLabel: 'Open protected workspace',
+    concealed: true,
+  }
+}
+
+function concealedSession(): SessionRowPresentation {
+  return {
+    label: 'Protected session',
+    ariaLabel: 'Open protected session',
+    concealed: true,
+  }
+}
