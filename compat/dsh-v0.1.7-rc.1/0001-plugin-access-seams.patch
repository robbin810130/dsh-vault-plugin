+// @vitest-environment jsdom
+import { render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+import { ProjectRowItem } from '../src/client/rows/Rows.tsx'
+
+const t = (key: string) => key
+
+function workspaceGroup() {
+  return {
+    key: 'workspace-a',
+    workspaceId: 'workspace-a',
+    label: 'Workspace A',
+    expanded: false,
+    containsCurrent: false,
+    createdAt: 1,
+    cwd: '/tmp/workspace-a',
+  } as never
+}
+
+describe('Workspace row extension slots', () => {
+  it('renders accessories and actions with the owning Workspace identity', () => {
+    const renderSlot = vi.fn((name: string, owner: { workspaceId: string }) => (
+      <span data-testid={name.endsWith('accessory') ? 'workspace-accessory' : 'workspace-action'}>
+        {owner.workspaceId}
+      </span>
+    ))
+    const renderSlotChain = vi.fn((_name: string, _owner: unknown, options?: { fallback?: React.ReactNode }) => options?.fallback)
+
+    render(<ProjectRowItem
+      group={workspaceGroup()}
+      onToggle={vi.fn()}
+      onCreate={vi.fn()}
+      t={t}
+      renderSlot={renderSlot as never}
+      renderSlotChain={renderSlotChain as never}
+    />)
+
+    expect(screen.getByTestId('workspace-accessory').textContent).toBe('workspace-a')
+    expect(screen.getByTestId('workspace-action').textContent).toBe('workspace-a')
+    expect(screen.getByTestId('workspace-accessory').parentElement).toBe(screen.getByRole('treeitem'))
+    expect(renderSlot).toHaveBeenCalledWith('sidebar.workspaces.workspace.row.accessory', {
+      workspaceId: 'workspace-a', displayTitle: 'Workspace A',
+    })
+    expect(renderSlot).toHaveBeenCalledWith('sidebar.workspaces.workspace.row.action', {
+      workspaceId: 'workspace-a', displayTitle: 'Workspace A',
+    })
+    expect(renderSlotChain).toHaveBeenCalledWith('sidebar.workspaces.workspace.row.title', {
+      workspaceId: 'workspace-a', displayTitle: 'Workspace A',
+    }, { fallback: expect.anything() })
+  })
+
+  it('does not expose Workspace actions on the ungrouped bucket', () => {
+    const renderSlot = vi.fn(() => null)
+    render(<ProjectRowItem
+      group={{ ...workspaceGroup(), workspaceId: undefined } as never}
+      onToggle={vi.fn()}
+      onCreate={vi.fn()}
+      t={t}
+      renderSlot={renderSlot as never}
+      renderSlotChain={vi.fn() as never}
+    />)
+    expect(renderSlot).not.toHaveBeenCalled()
+  })
+})
